<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="yoloBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e293b;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#334155;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#yoloBg)"/>
  <rect x="150" y="150" width="200" height="150" rx="5" fill="none" stroke="#10b981" stroke-width="3"/>
  <text x="160" y="180" font-family="monospace" font-size="16" fill="#10b981">Car 98%</text>
  <rect x="450" y="200" width="150" height="120" rx="5" fill="none" stroke="#3b82f6" stroke-width="3"/>
  <text x="460" y="230" font-family="monospace" font-size="16" fill="#3b82f6">Person 95%</text>
  <rect x="250" y="350" width="100" height="80" rx="5" fill="none" stroke="#fbbf24" stroke-width="3"/>
  <text x="260" y="380" font-family="monospace" font-size="16" fill="#fbbf24">Sign 92%</text>
  <text x="400" y="80" font-family="Arial, sans-serif" font-size="42" fill="white" text-anchor="middle" font-weight="bold">YOLO DETECTION</text>
  <text x="400" y="550" font-family="monospace" font-size="24" fill="#10b981" text-anchor="middle">Autonomous Driving</text>
</svg>
